{
  "properties": {
    "connectionParameters": {
      "api_key": {
        "type": "securestring",
        "uiDefinition": {
          "displayName": "API key",
          "description": "Your Magic Hour API key. Enter the raw key without the Bearer prefix.",
          "tooltip": "Create an API key at magichour.ai/settings/api-keys.",
          "constraints": {"tabIndex": 2, "clearText": false, "required": "true"}
        }
      }
    },
    "iconBrandColor": "#09090B",
    "capabilities": ["actions"],
    "policyTemplateInstances": [
      {
        "templateId": "setheader",
        "title": "Add Bearer authentication",
        "parameters": {
          "x-ms-apimTemplateParameter.name": "Authorization",
          "x-ms-apimTemplateParameter.value": "Bearer @connectionParameters('api_key')",
          "x-ms-apimTemplateParameter.existsAction": "override",
          "x-ms-apimTemplate-policySection": "Request"
        }
      }
    ],
    "publisher": "Magic Hour",
    "stackOwner": "Magic Hour"
  }
}
